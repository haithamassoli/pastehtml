# Copy to .env.local and fill in. See README "Environment setup".

# App — the root host paste subdomains hang off. Production:
# NEXT_PUBLIC_APP_URL=https://pastehtml.assoli.site
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Convex — set automatically by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk — from the Clerk dashboard (API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Convex deployment env (set with `npx convex env set`, not in .env.local)
# CLERK_JWT_ISSUER_DOMAIN=https://<your-app>.clerk.accounts.dev
