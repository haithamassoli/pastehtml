# Copy to .env.local and fill in. See README "Environment setup".

# App — the root host paste subdomains hang off. Production:
# NEXT_PUBLIC_APP_URL=https://pastehtml.assoli.site
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Convex — set automatically by `npx convex dev`. On Vercel these three are
# NOT set: the build runs `npx convex deploy --cmd 'npm run build'`, which
# injects NEXT_PUBLIC_CONVEX_URL and NEXT_PUBLIC_CONVEX_SITE_URL itself from
# CONVEX_DEPLOY_KEY. Setting them there would only mask a broken deploy key.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk — from the Clerk dashboard (API keys). Locally and on Vercel Preview
# these are the development instance's pk_test_/sk_test_ pair; Vercel
# Production carries the production instance's pk_live_/sk_live_ pair instead.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Convex deployment env (set with `npx convex env set`, not in .env.local).
# Production is https://clerk.pastehtml.assoli.site — see docs/operations.md.
# CLERK_JWT_ISSUER_DOMAIN=https://<your-app>.clerk.accounts.dev

# Playwright auth specs. Optional — defaults to e2e+clerk_test@example.com.
# See README "Testing" for the one command that creates the fixture user.
# E2E_CLERK_USER_EMAIL=e2e+clerk_test@example.com

# Error tracking. Optional and off by default — `lib/sentry.ts` no-ops without
# it. Paste the DSN from Sentry (Settings → Projects → <project> → Client Keys);
# set it in the Vercel project, not in git. See docs/operations.md.
# NEXT_PUBLIC_SENTRY_DSN=
